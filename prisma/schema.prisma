// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum SubmissionStatus {
  DRAFT
  FINAL
}

model Competition {
  id          String              @id @default(cuid())
  name        String
  eventDate   DateTime
  isActive    Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  judges      Judge[]
  companies   Company[]
  categories  Category[]
  sessions    SubmissionSession[]
  scores      Score[]
}

model Judge {
  id            String              @id @default(cuid())
  competitionId String
  name          String
  code          String?
  createdAt     DateTime            @default(now())
  competition   Competition         @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  sessions      SubmissionSession[]
  scores        Score[]

  @@unique([competitionId, name])
}

model Company {
  id            String      @id @default(cuid())
  competitionId String
  name          String
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]

  @@unique([competitionId, name])
}

model Category {
  id            String      @id @default(cuid())
  competitionId String
  name          String
  weight        Int
  maxScore      Int         @default(5)
  createdAt     DateTime    @default(now())
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  scores        Score[]

  @@unique([competitionId, name])
}

model SubmissionSession {
  id            String           @id @default(cuid())
  competitionId String
  judgeId       String
  status        SubmissionStatus @default(DRAFT)
  submittedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  competition   Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judge         Judge            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  scores        Score[]

  @@unique([competitionId, judgeId])
}

model Score {
  id            String            @id @default(cuid())
  competitionId String
  judgeId       String
  companyId     String
  categoryId    String
  sessionId     String
  score         Float
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  competition   Competition       @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  judge         Judge             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  session       SubmissionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, judgeId, companyId, categoryId])
}
