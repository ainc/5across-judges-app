# Supabase Postgres (Project Settings -> Database)
# Transaction pooler (port 6543) - used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# NextAuth - generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for npm run db:seed
ADMIN_PASSWORD=
JUDGE_PASSWORD=

# Optional username overrides (defaults shown)
# ADMIN_USERNAME=admin
# JUDGE1_USERNAME=judge1
# JUDGE2_USERNAME=judge2
# JUDGE3_USERNAME=judge3
